..@import("stream");

extend byte* {
    uint strlen = fn(self) {
        for var i := 0 as uint; self.*[i] != 0; i++ {}
        i
    }

    int strlen_r = fn(self) {
        let j := 0;
        for let i := 0; self.*[i] != 0; i++ { j--; }
        j--
    }

    void print = fn(self) {
        syscall! 0x1(1, self.*, self.*.strlen());
    }

    stream to_stream = fn(self) {
        return self.*.strlen(), self.*;
    }
}

extend generic_ptr {
    stream to_stream = fn(self) {
        let ptr := self.* as byte*;
        return ptr.strlen(), ptr;
    }
}

extend int {
    void print = fn(self) {
        let c := 0 as byte;
        let v := self.*;

        if v < 0 {
            c = 45;
            syscall! 0x1(1, &c, 1);
            v = 0 - v;
        }

        let d := 1;
        while v / d >= 10 {
            d = d * 10;
        }

        while d > 0 {
            c = (v / d % 10 + 48) as byte;
            syscall! 0x1(1, &c, 1);
            d = d / 10;
        }

        syscall! 0x1(1, "\n", 1);
    }
}
