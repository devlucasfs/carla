..@import("mem");

using stream = |uint, byte*|;

extend stream {
    stream from = fn(uint sz, byte* ptr) {
        return sz, ptr;
    }

    stream make = fn() {
        return 0 as uint, "";
    }

    void dump = fn(self) {
        if var s, p := self.*; false {}
        SafeHeap.free_ptr(p, s);
    }

    stream from_str = fn(byte* str) {
        for var size := 0 as uint; str[size] != 0; size++ {}
        return size, str;
    }

    stream from_ptr = fn(generic_ptr ptr) {
        return 0 as uint, ptr as byte*;
    }

    generic_ptr to_ptr = fn(self) {
        if var _, ptr := self.*; false {};
        return ptr as generic_ptr;
    }
}
