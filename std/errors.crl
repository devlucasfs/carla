void eprint = fn(byte* p) {
    for var i := 0 as uint; p[i] != 0; i++ {}
    syscall! 0x1(1, p, i);
    syscall! 0x3c(1);
}

using error = |bool, byte*|;
extend error {
    error from = fn(byte* str) {
        return true, str;
    }

    error make = fn() {
        return false, "";
    }

    void panic = fn(self) {
        if var _, msg := self.*; true {}
        eprint(msg);
    }

    byte* msg = fn(self) {
        if var _, msg := self.*; true {}
        msg
    }

    bool isnt_empty = fn(self) {
        if var b, _ := self.*; true {}
        b
    }

    bool is_empty = fn(self) {
        if var b, _ := self.*; true {}
        if b : return false;
        return true;
    }
}
