..@import("errors");

using vector = |Nashj, uint, uint, Nashj.Qitah, Nashj.Qitah, Nashj.Qitah|;
extend vector {
    vector init = fn(uint headers_sz, bytes_sz) {
        let headers_size := headers_sz * sizeof(generic_ptr);
        let bytes_size   := bytes_sz;
        let size         := headers_size + sizeof(word) + bytes_size;

        let allocator    := Nashj.init(size as uint);

        let headers      := allocator.alloc(headers_size as uint);
        let length       := allocator.alloc(sizeof(uword));
        let bytes        := allocator.alloc(bytes_size as uint - 16);

        return allocator, size, headers_sz, length, headers, bytes;
    }

    void deinit = fn(self) {
        if var nashj, _, _, _, _, _ := self.*; true {}
        nashj.deinit();
    }

    uint allocation_size = fn(self) {
        if var _, size, _, _, _, _ := self.*; true {}
        size
    }

    void push = fn(self, byte* raw, uint size) {
        if var _, _, headers_size, length, headers, bytes := self.*; true {}
        let word_addr := length.to_raw() as uword*;
        word_addr.* += 1;

        let headers_ptr := headers.to_raw() as generic_ptr**;

        let ptr := bytes.to_raw();

        for let i := 0 as uint; i < size; i++ {
            ptr[i] = raw[i];
        }

        headers_ptr[word_addr.* as int - 1] = ptr as generic_ptr*;
    }

    uint size = fn(self) {
        if var _, _, _, length, _, _ := self.*; true {}
        let word_addr := length.to_raw() as uword*;
        word_addr.* as uint
    }

    @uncert(generic_ptr) get = fn(self, uint i) {
        if var _, _, _, length, headers, _ := self.*; true {}

        let word_addr   := length.to_raw() as uword*;
        let headers_ptr := headers.to_raw() as generic_ptr*;

        if i >= vector.size(self) {
            return nullptr, error.from("index can't be above or equal than the vector size.");
        }

        return headers_ptr[i], error.make();
    }
}
