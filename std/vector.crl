..@import("stream");
..@import("errors");
..@import("mem");

using vector = |Nashj, uint, uint, Nashj.Qitah, Nashj.Qitah|;
extend vector {
    vector init = fn(uint capacity) {
        let blocks_size := capacity * sizeof(generic_ptr);
        int size         = blocks_size as int + sizeof(uword) + 32;

        let allocator := Nashj.init(size as uint);

        let length := allocator.alloc(sizeof(uword));
        let mem := allocator.alloc(blocks_size as uint);

        return allocator, size as uint, capacity, length, mem;
    }

    uint size = fn(self) {
        if var _, _, _, length, _ := self.*; true {}
        let word_addr := length.to_raw() as uword*;
        word_addr.* as uint
    }

    void deinit = fn(self) {
        if var nashj, _, _, _, mem := self.*; true {}
        let memptr := mem.to_raw() as SafeHeap.Cell*;

        for uint i : 0..vector.size(self) {
            SafeHeap.dump(memptr[i]);
        }

        nashj.deinit();
    }

    uint allocation_size = fn(self) {
        if var _, size, _, _, _ := self.*; true {}
        size
    }

    error push = fn(self, stream data) {
        if var _, _, capacity, length, mem := self.*; true {}

        let len_addr := length.to_raw() as uword*;
        let index := len_addr.* as uint;
        if capacity <= index
            : return error.from("Vector is already full");

        len_addr.* += 1;

        if var size, raw := data; size == 0
            : return error.from("Invalid stream received: Size equals to 0\n");

        let into     := SafeHeap.alloc(size);
        let into_raw := into.to_raw();

        for uint i : 0..size {
            into_raw[i] = raw[i];
        }

        let memptr := mem.to_raw() as SafeHeap.Cell*;
        memptr[index] = into;

        error.make()
    }

    @uncert(stream) get = fn(self, uint i) {
        if var _, _, _, length, mem := self.*; true {}

        if i >= vector.size(self)
            : return stream.make(), error.from("index can't be greater or equal to the vector size.\n");

        let memptr := mem.to_raw() as SafeHeap.Cell*;
        let cell := memptr[i];

        return stream.from(cell.size(), cell.to_raw()), error.make();
    }
}
