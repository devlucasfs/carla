unfold int main = fn();

constexpr(runa: arch == xtensa_lx7)
{ void app_main = fn() { main(); } }

constexpr(runa: arch == avr)
{ void _start = fn() { main(); } }

constexpr(runa: arch == x86_64 and os == Linux)
{ void _start = fn() { syscall! 0x3C(main()); } }

constexpr(runa: arch == x86 and os == Linux)
{ void _start = fn() { syscall! 0x1(main()); } }
