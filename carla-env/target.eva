@target
' Specify the file who your entrypoint is in.
main: "src/main.crl"

' The .lua file must contain the definitions—evaluated at compile
' time—that will be used to cross-compile the same codebase, by
' enabling or disabling the inclusion of specific blocks of code.
constexpr: "core/constexpr.lua"

' List all the targets you want to build your Carla program for.
'
' Each entry specifies a target platform and architecture to compile for.
' For example, "avr_atmega328p" targets the ATmega328P microcontroller.
'
' Use "auto" to automatically detect the operating system and architecture
' of the machine currently running the compiler, and build for that target.
' This is useful when you simply want a native build for your current system.
'
' You can specify multiple targets to cross-compile the same codebase
' for different platforms in a single build.
artifacts: [
    { target: "auto" outputs: [ "native-bin", "static-archive", "shared-object" ] }
]

@precompiler
' Carla ships with a built-in precompiler that handles the
' language's native preprocessing features. It is always enabled
' and cannot be disabled.
'
' Configure an additional precompiler below to extend the native
' preprocessing pipeline with extra capabilities. `norn` is the
' default extension, but you may replace it with any compatible
' implementation.
name: "norn"
