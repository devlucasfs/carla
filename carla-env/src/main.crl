using pins = enum(
    led = expr(1 << 5)
);

void sleep = fn(int cycles) {
    for int i = 0; i <= cycles; i++ {}
}

@_start
int main = fn() {
    let ddrb := reg[0x04];
    let portb := reg[0x05];

    ddrb |= pins.led;

    while true {
        portb |= pins.led;
        sleep(50000);
        portb &= !(pins.led);
        sleep(50000);
    }
}
