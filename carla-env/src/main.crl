..@import("extensions");
..@import("nashj");
..@import("vector");
..@import("mem");

@_start
int main = fn() {
    SafeHeap.init(4096);
    defer SafeHeap.deinit();

    let vec := vector.init(1024);
    defer vec.deinit();

    for uint i : 0..12 {
        if i % 2 == 0 {
            vec.push(stream.from_str("Hello, world!\n"));
            continue;
        }
        vec.push(stream.from_str("I love Samar!\n"));
    }

    for uint i : 0..vec.size() {
        if var data, err := vec.get(i); err.isnt_empty() { err.panic(); }
        if var _, c := data; true {}
        c.print();
    }

    0
}
