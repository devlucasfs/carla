int main = fn () {
    let allocator := nashj_start(1024);
    defer nashj_destroy(&allocator);

    let mem := nashj_alloc(&allocator, 32);
    defer nashj_dump(&allocator, mem);

    development_fill(mem, 0, 14); -- fill with Hello world
    development_debug(mem);

    0
}


