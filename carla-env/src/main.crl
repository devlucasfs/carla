..@import("nashj");
..@import("extensions");
..@import("vector");

@_start
int main = fn() {
    let vec := vector.init(128, 4096);
    defer vec.deinit();

    let m := "If i love Samar, that will work in the first attempt\n";
    vec.push(m, m.strlen());

    if var data, err := vec.get(0); err.isnt_empty() {
        let msg := err.msg();
        msg.print();
    }

    let content := data as byte*;
    content.print();

    0
}
