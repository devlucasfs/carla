..@import("croutines");

void test = fn(CRoutines* r, stream args) {
    if var _, msg := args; false {}
    for 0..3 {
        msg.print();
        r.*.yield();
    }
}

@_start
int main = fn() {
    SafeHeap.init(1024 * 10);
    defer SafeHeap.deinit();

    let r := CRoutines.from(CRoutineDefault.sp_size, CRoutineDefault.vec_size);

    CRoutine.spawn(&r, ::test, stream.from_str("I love "));
    CRoutine.spawn(&r, ::test, stream.from_str("Samar"));
    CRoutine.spawn(&r, ::test, stream.from_str("!\n"));
    CRoutine.join(&r);

    0
}
